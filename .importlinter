[importlinter]
root_package = neurospatial
include_external_packages = True
exclude_type_checking_imports = True

[importlinter:contract:layers]
name = Environment adapters sit above independent builders and numerical operations
type = layers
layers =
    neurospatial.environment
    neurospatial.layout | neurospatial.ops
    neurospatial.geometry

[importlinter:contract:geometry]
name = Owned geometry stays independent of analysis, storage and rendering
type = forbidden
source_modules =
    neurospatial.geometry
forbidden_modules =
    neurospatial.environment
    neurospatial.layout
    neurospatial.ops
    neurospatial.encoding
    neurospatial.decoding
    neurospatial.behavior
    neurospatial.events
    neurospatial.stats
    neurospatial.regions
    neurospatial.animation
    neurospatial.simulation
    neurospatial.annotation
    neurospatial.io
    matplotlib
    pynwb
    napari
    xarray
    pynapple
