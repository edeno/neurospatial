{
  "dataset": "grieves_2020",
  "paper": "Grieves et al. (2020)",
  "paper_citation": "Grieves RM, Jedidi-Ayoub S, Mishchanchuk K, Liu A, Renaudineau S, Jeffery KJ (2020). The place-cell representation of volumetric space in rats. Nature Communications 11:789. https://doi.org/10.1038/s41467-020-14611-7",
  "species": "rat",
  "brain_regions": [
    "CA1"
  ],
  "apparatus": "cubic climbing lattice, 0.97 m a side (6 x 6 x 6 cubes of 150 mm tubes), aligned or tilted onto a vertex, between square arena sessions",
  "license": "CC0",
  "archive": {
    "name": "UCL Research Data Repository 9926477 (version 1)",
    "url": "https://doi.org/10.5522/04/9926477.v1",
    "citation": "Grieves, Roddy; Jedidi-Ayoub, Selim; Mishchanchuk, Karyna; Liu, Anyi; Renaudineau, Sophie; Jeffery, Kate (2020). Place-cell representation of volumetric space in rats. University College London. Dataset. https://doi.org/10.5522/04/9926477.v1"
  },
  "stated": {
    "sampling_rate": {
      "value": 50.0,
      "basis": "stated",
      "source": "each session file's position_srate_hz (50) and config.srate (50); the Supplementary Methods of Grieves et al. 2020 state that the cameras tracked the LEDs 'at a 25Hz sampling frequency', which the files' 0.02 s steps do not match"
    },
    "position_span": {
      "value": [
        77.6,
        201.6
      ],
      "basis": "stated",
      "source": "the Supplementary Methods of Grieves et al. 2020: a 6 x 6 x 6 cubic maze, 0.97 m a side, aligned or 'rotated (45 deg around its Z-axis and 54.74 deg around its X-axis)' to stand on a vertex, 0.97 x sqrt(3) = 1.68 m tall; the largest span of the tracked positions must lie between 80% of the side (77.6 cm) and 120% of the tilted height (201.6 cm)"
    },
    "speed_limit": {
      "value": 393.0,
      "basis": "stated",
      "source": "Iriarte-Díaz 2002, J. Exp. Biol. 205:2897-2908, Table 1: Rattus runs at most 13.78 body lengths/s at a 0.190 m body length, 2.62 m/s (from Garland 1983 and Nowak 1999); times 1.5 because the tracked point is the headstage's LEDs, which swing faster than the body, and no source read states head speed"
    }
  },
