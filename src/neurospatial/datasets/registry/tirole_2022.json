{
  "dataset": "tirole_2022",
  "paper": "Tirole et al. (2022)",
  "paper_citation": "Tirole M, Huelin Gorriz M, Takigawa M, Kukovska L, Bendor D (2022). Experience-driven rate modulation is reinstated during hippocampal replay. eLife 11:e79031. https://doi.org/10.7554/eLife.79031",
  "species": "rat",
  "brain_regions": [
    "dorsal CA1"
  ],
  "apparatus": "two novel 2 m linear tracks of changing shape in one room, run back and forth for about 15 min each, with a 20 cm rest pot for 1 h before, 10 min between and 2 h after",
  "license": "CC0-1.0",
  "archive": {
    "name": "Zenodo 7114733 (mirror of Dryad 10.5061/dryad.ksn02v76h)",
    "zenodo": "7114733",
    "citation": "Takigawa M, Kukovska L, Tirole M, Huelin M, Bendor D (2023). Experience-driven rate modulation is reinstated during hippocampal replay [Data set]. Zenodo, mirror of Dryad. https://doi.org/10.5061/dryad.ksn02v76h",
    "not_offered": [
      "rat4_session1"
    ],
    "not_offered_why": "the deposit's RAT4_SESS1 spike and position files are byte-identical copies of RAT1_SESS2's, which are Rat 1 session 1; only its LFP (RAT4_SESS1_extracted_CSC.mat) is Rat 4 session 1's",
    "url": "https://doi.org/10.5061/dryad.ksn02v76h"
  },
  "stated": {
    "sampling_rate": {
      "value": 25.0,
      "basis": "stated",
      "source": "the deposit README.txt: position.t is min(positions.timestamps):0.04:max(positions.timestamps), the camera being at 25Hz (1/25=0.04)"
    },
    "position_span": {
      "value": [
        150.0,
        350.0
      ],
      "basis": "inferred",
      "source": "no source read states the room or the camera's view. The camera sees both 2 m tracks, bent into a different shape each session, and the rest pot; at the file's average cm per pixel the largest per-axis span of the tracked samples is 195 to 280 cm over the nine sessions; the range allows about 25% either side"
    },
    "speed_limit": {
      "value": 393.0,
      "basis": "stated",
      "source": "Iriarte-D\u00edaz 2002, J. Exp. Biol. 205:2897-2908, Table 1: Rattus runs at most 13.78 body lengths/s at a 0.190 m body length, 2.62 m/s (from Garland 1983 and Nowak 1999); times 1.5 because the tracked point is a head-mounted LED pair, which swings faster than the body, and no source read states head speed"
    }
  },
